echo -e "${Color_Off}"

#Dependency Check
msg INFO "Checking system dependencies..."
DEPENDENCIES=(hyprland jq)
for pkg in "${DEPENDENCIES[@]}"; do
    if ! pacman -Qs "$pkg" > /dev/null; then
        msg WARN "$pkg not found. Installing..."
        sudo pacman -S --noconfirm "$pkg" || { msg ERROR "Installation failed."; exit 1; }
    fi
done
msg SUCCESS "Dependencies satisfied."

#Monitor Detection
msg INFO "Scanning for outputs..."
mapfile -t MONITORS < <(hyprctl monitors all -j | jq -r '.[].name')

if [ ${#MONITORS[@]} -eq 0 ]; then
    msg ERROR "No outputs detected."
    exit 1
fi

select_option "${MONITORS[@]}"
CHOICE_INDEX=$?
TARGET_MONITOR="${MONITORS[$CHOICE_INDEX]}"

msg SUCCESS "Target set to: $TARGET_MONITOR"
echo -e "\n${BPurple}--- Configuration Settings (Press Enter for Defaults) ---${Color_Off}"

#Resolution default: preferred
read -p "Resolution [preferred]: " RES
RES=${RES:-preferred}

#Refresh Rate default: 60
read -p "Refresh Rate [60]: " REFRESH
REFRESH=${REFRESH:-60}

#Position default: auto
read -p "Position [auto]: " POS
POS=${POS:-auto}

#Scale default: 1
read -p "Scale [1]: " SCALE
SCALE=${SCALE:-1}

#Construct the line
if [ "$RES" = "preferred" ] && [ "$POS" = "auto" ]; then
    CONF_LINE="monitor=$TARGET_MONITOR, preferred, auto, $SCALE"
else
    CONF_LINE="monitor=$TARGET_MONITOR, ${RES}@${REFRESH}, $POS, $SCALE"
fi

#Applying Changes
msg INFO "Updating hyprland.conf..."
CONFIG_FILE="$HOME/.config/hypr/hyprland.conf"

mkdir -p "$(dirname "$CONFIG_FILE")"
touch "$CONFIG_FILE"

#Clean up previous entries
sed -i '/# \[MONITOR-SCRIPT-BEGIN\]/,/# \[MONITOR-SCRIPT-END\]/d' "$CONFIG_FILE"
cat << EOF >> "$CONFIG_FILE"

# [MONITOR-SCRIPT-BEGIN]
# Auto-generated by M0niTHOR
$CONF_LINE
# [MONITOR-SCRIPT-END]
EOF

msg SUCCESS "Config applied to $CONFIG_FILE"
msg INFO "Reloading Hyprland..."
hyprctl reload
msg SUCCESS "Setup complete!"